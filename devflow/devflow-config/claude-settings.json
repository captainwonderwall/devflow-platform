{
  "permissions": {
    "allow": [
      "Bash(diagram *)",
      "Bash(start-issue *)",
      "Bash(draft-pr *)",
      "Bash(address-pr *)",
      "Bash(finish-issue *)",
      "Bash(squash-commits *)",

{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "sed *": "allow",
      "yarn *": "allow",
      "nvm *": "allow",
      "curl *": "allow",
      "gh api *--method PATCH*": "allow",
      "git *": "allow",
      "head *": "allow",
      "playwright-cli *": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": "allow",
    "task": "allow",
    "todoread": "allow",
    "todowrite": "allow"
  }
}
